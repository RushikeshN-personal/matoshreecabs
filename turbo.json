{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV", "BACKEND_ORIGIN", "NEXT_PUBLIC_API_URL"]
    },
    "dev": { "cache": false, "persistent": true, "dependsOn": ["^build"] },
    "lint": {}
  }
}

